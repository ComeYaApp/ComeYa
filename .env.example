# ============================================
# ComeYa - Plataforma de Delivery Soria, España
# ============================================

# ============================================
# DATABASE - Aiven MySQL Production
# ============================================
DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@comeya-comeya.d.aivencloud.com:28942/defaultdb?ssl-mode=REQUIRED
DB_HOST=comeya-comeya.d.aivencloud.com
DB_PORT=28942
DB_USER=avnadmin
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=defaultdb

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secure_jwt_secret_here_min_32_chars
REFRESH_SECRET=your_super_secure_refresh_secret_here_min_32_chars

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://app.comeya.es
BACKEND_URL=https://api.comeya.es

# ============================================
# COMEYA CONFIG
# ============================================
COMEYA_NAME=ComeYa
COMEYA_LOCATION=Soria, Castilla y León, España
COMEYA_SUPPORT_EMAIL=soporte@comeya.es

# ============================================
# GOOGLE MAPS API
# ============================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================
# GOOGLE GEMINI AI (Optional)
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here
AI_INTEGRATIONS_GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# COMMISSIONS (%)
# ============================================
COMEYA_COMMISSION=15
BUSINESS_COMMISSION=100
DRIVER_COMMISSION=100

# ============================================
# ORDER CONFIGURATION
# ============================================
REGRET_PERIOD_SECONDS=60
BUSINESS_CALL_DELAY_MINUTES=3
FUND_HOLD_HOURS=1
AUTO_FUND_RELEASE_HOURS=24

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# PAYMENT METHODS - Spain (Soria)
# ============================================

# Bizum (Primary payment method in Spain)
COMEYA_BIZUM_PHONE=+34 600 000 000
COMEYA_BIZUM_ENABLED=true

# Bank Transfer (ESPAÑOL)
COMEYA_IBAN=ES00 0000 0000 0000 0000 0000
COMEYA_BANK_NAME=Banco Santander
COMEYA_ACCOUNT_HOLDER=ComeYa Delivery S.L.

# Legacy: Pago Móvil (Venezuela - deprecated)
# COMEYA_PAGO_MOVIL_PHONE=0414-000-0000
# COMEYA_PAGO_MOVIL_BANK=banesco

# ============================================
# STRIPE PAYMENTS (Optional)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# ============================================
# CASH PAYMENTS
# ============================================
MAX_CASH_ORDER=100
MAX_CASH_OWED_PER_DRIVER=100
LIQUIDATION_DEADLINE_DAYS=7
WARNING_THRESHOLD_DAYS=5

# ============================================
# TWILIO SMS VERIFICATION (Optional)
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# ============================================
# RESEND EMAIL (Optional)
# ============================================
RESEND_API_KEY=

# ============================================
# CLOUDINARY (Images)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret