# ComeYa - Configuración de Producción (Render)
# Copia este archivo a .env.production y actualiza los valores

# URLs de Producción
EXPO_PUBLIC_API_URL=https://comeya-backend.onrender.com
EXPO_PUBLIC_BACKEND_URL=https://comeya-backend.onrender.com
EXPO_PUBLIC_FRONTEND_URL=https://app.comeya.es

# Entorno
EXPO_PUBLIC_NODE_ENV=production

# Información de la App
EXPO_PUBLIC_APP_NAME=ComeYa
EXPO_PUBLIC_APP_VERSION=1.0.1

# Google Maps API Key (Android + iOS)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Nota: Las variables sensibles deben configurarse como secrets en EAS
# o en el dashboard de Render, NO en este archivo.
# Para EAS Build, las variables de entorno se configuran en eas.json > build > production > env