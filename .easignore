# Control de versiones. Importante: al existir un .easignore propio, EAS deja
# de aplicar sus exclusiones por defecto y .git() se subia entero: 614 MB de
# historial en CADA build, que es la causa de que la subida pareciera quedarse
# colgada sin mostrar nada. EAS solo necesita el arbol de trabajo; el hash del
# commit lo calcula con git en local.
.git/

# Binarios de herramientas locales que no participan en la compilacion
# (cloudflared para tuneles, bundletool para inspeccionar APKs)
cloudflared.exe
bundletool.jar

# Node modules (EAS Build los reconstruye con npm install)
node_modules/

# Build outputs de Android (no necesarios para iOS, ocupan 2.5 GB)
android/
# Excepción: el keystore de firma debe poder subirse a EAS Build
!android/app/
!android/app/release.keystore

# Artefactos locales: los APK/AAB no deben subirse a EAS (ocupan cientos de MB
# y fueron la causa del ECONNRESET en la subida)
*.apk
*.aab

# Documentos del cliente (el PDF de requisitos pesa 17 MB y no hace falta
# para compilar: solo alarga la subida del proyecto a EAS)
docs/requerimentos/

# Cache de Gradle
.gradle-comeya/
.gradle/

# Node modules cache
node_modules/.cache/

# Expo
.expo/
dist/

# Build outputs del servidor
server_dist/

# TypeScript
*.tsbuildinfo

# macOS
.DS_Store

# Archivos de entorno (se inyectan via EAS Build env)
.env
.env.local
.env.production

# IDE
.vscode/
.idea/

# Tests y QA
test_body.json
test_auth.js
QA_REPORT_FINAL.md
QA_TEST_PLAN.md
coverage/
tests/

# Scripts de build locales
*.bat
*.cmd
*.ps1
!start-local.bat

# Logs
*.log
ultimos_200_git_logs.md

# Documentación
*.md
!README.md